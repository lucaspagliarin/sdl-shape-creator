<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="SDL_Shape_Creator" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/SDL_Classes" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="/usr/include/SDL2" />
					<Add directory="include" />
					<Add directory="C:/SDL2/include" />
				</Compiler>
				<Linker>
					<Add option="-lmingw32" />
					<Add option="-lSDL2main" />
					<Add option="-lSDL2" />
					<Add directory="C:/SDL2/lib" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/SDL_Classes" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
		</Compiler>
		<Unit filename="include/Bezier.h" />
		<Unit filename="include/Circle.h" />
		<Unit filename="include/Color.h" />
		<Unit filename="include/Context.h" />
		<Unit filename="include/Line.h" />
		<Unit filename="include/Painter.h" />
		<Unit filename="include/Point.h" />
		<Unit filename="include/Polygon.h" />
		<Unit filename="include/Rectangle.h" />
		<Unit filename="include/Shape.h" />
		<Unit filename="include/Utils.h" />
		<Unit filename="main.cpp" />
		<Unit filename="src/Bezier.cpp" />
		<Unit filename="src/Circle.cpp" />
		<Unit filename="src/Color.cpp" />
		<Unit filename="src/Context.cpp" />
		<Unit filename="src/Line.cpp" />
		<Unit filename="src/Painter.cpp" />
		<Unit filename="src/Point.cpp" />
		<Unit filename="src/Polygon.cpp" />
		<Unit filename="src/Rectangle.cpp" />
		<Unit filename="src/Shape.cpp" />
		<Unit filename="src/Utils.cpp" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
