{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "compilar sdl2 cpp",
            "command": "clang++ -std=c++20 -Wall -Wextra -g3 ${workspaceFolder}/*.cpp ${workspaceFolder}/src/*.cpp -I${workspaceFolder}/include -I/opt/homebrew/include -L/opt/homebrew/lib -lSDL2 -o ${workspaceFolder}/output/main",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
